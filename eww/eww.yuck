;; ╔══════════════════════════════════════════╗
;; ║   SIDEBAR - eww port of conky.conf       ║
;; ║   Translúcido, sin fondo, top_right      ║
;; ╚══════════════════════════════════════════╝

;; ─── VARIABLES POLLING ──────────────────────

(defpoll cpu_use    :interval "2s"  `~/.config/eww/scripts/cpu_use.sh`)
(defpoll cpu_freq   :interval "2s"  `cat /proc/cpuinfo | grep 'cpu MHz' | head -1 | awk '{printf "%.0f", $4}'`)
(defpoll cpu_freq_g :interval "2s"  `cat /proc/cpuinfo | grep 'cpu MHz' | head -1 | awk '{printf "%.2f", $4/1000}'`)
(defpoll cpu_temp   :interval "2s"  `~/.config/eww/scripts/cpu_temp.sh`)
(defpoll cpu_model  :interval "3600s" `cat /proc/cpuinfo | grep 'model name' | head -1 | sed 's/.*: //' | cut -c1-40`)
(defpoll procs_total :interval "2s" `ls /proc | grep -c '^[0-9]'`)
(defpoll procs_run  :interval "2s"  `cat /proc/loadavg | awk '{print $4}' | cut -d/ -f2`)

(defpoll ram_used   :interval "2s"  `free -h | awk '/^Mem:/{print $3}'`)
(defpoll ram_total  :interval "2s"  `free -h | awk '/^Mem:/{print $2}'`)
(defpoll ram_pct    :interval "2s"  `free | awk '/^Mem:/{printf "%.0f", $3/$2*100}'`)
(defpoll swap_used  :interval "2s"  `free -h | awk '/^Swap:/{print $3}'`)
(defpoll swap_total :interval "2s"  `free -h | awk '/^Swap:/{print $2}'`)
(defpoll swap_pct   :interval "2s"  `free | awk '/^Swap:/{if($2>0) printf "%.0f", $3/$2*100; else print "0"}'`)

(defpoll gpu_name   :interval "60s"  `nvidia-smi --query-gpu=gpu_name --format=csv,noheader,nounits 2>/dev/null || echo "N/A"`)
(defpoll gpu_clock  :interval "2s"   `nvidia-smi --query-gpu=clocks.current.memory --format=csv,noheader 2>/dev/null || echo "N/A"`)
(defpoll gpu_use    :interval "2s"   `nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null || echo "0"`)
(defpoll gpu_mem_u  :interval "2s"   `nvidia-smi --query-gpu=memory.used --format=csv,noheader 2>/dev/null || echo "N/A"`)
(defpoll gpu_mem_t  :interval "2s"   `nvidia-smi --query-gpu=memory.total --format=csv,noheader 2>/dev/null || echo "N/A"`)
(defpoll gpu_temp   :interval "2s"   `nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader 2>/dev/null || echo "N/A"`)

(defpoll disk_used  :interval "10s"  `df -h / | awk 'NR==2{print $3}'`)
(defpoll disk_total :interval "10s"  `df -h / | awk 'NR==2{print $2}'`)
(defpoll disk_pct   :interval "10s"  `df / | awk 'NR==2{print $5}' | tr -d '%'`)
(defpoll disk_io    :interval "2s"   `~/.config/eww/scripts/diskio.sh`)

(defpoll net_iface  :interval "5s"   `ip route | grep default | awk '{print $5}' | head -1`)
(defpoll net_down   :interval "2s"   `~/.config/eww/scripts/net_down.sh`)
(defpoll net_up     :interval "2s"   `~/.config/eww/scripts/net_up.sh`)
(defpoll net_ssid   :interval "5s"   `iwgetid -r 2>/dev/null || echo ""`)

(defpoll top_procs  :interval "3s"   `~/.config/eww/scripts/top_procs.sh`)

(deflisten uptime_s `bash -c 'while true; do uptime -p | sed "s/up //;s/ hours\?/h/;s/ minutes\?/m/"; sleep 5; done'`)
(deflisten kernel_s `uname -r`)
(deflisten arch_s   `uname -m`)

;; ─── WIDGETS ────────────────────────────────

(defwidget divider []
  (label :class "divider" :text "──────────────────────────────"))

(defwidget row [label value]
  (box :class "row" :orientation "h" :space-evenly false
    (label :class "lbl" :text label :xalign 0 :hexpand true)
    (label :class "val" :text value :xalign 1)))

(defwidget bar-row [label value pct]
  (box :class "bar-row" :orientation "v" :space-evenly false
    (row :label label :value value)
    (scale :class "pbar" :value {pct ?: 0} :min 0 :max 100 :active false :hexpand true)))

;; INFO
(defwidget w-info []
  (box :class "section" :orientation "v" :space-evenly false
    (box :orientation "h" :space-evenly false :class "info-header"
      (label :class "icon" :text " ")
      (label :class "lbl" :text "Info: ")
      (label :class "val" :text "${kernel_s} ${arch_s}" :truncate true))
    (divider)
    (row :label " Active Time:" :value uptime_s)))

;; CPU
(defwidget w-cpu []
  (box :class "section" :orientation "v" :space-evenly false
    (box :orientation "h" :space-evenly false
      (label :class "icon" :text " ")
      (label :class "lbl" :text "CPU: ")
      (label :class "val" :text cpu_model :truncate true))
    (row :label "CPU Clock:" :value "${cpu_freq} MHz")
    (row :label "CPU Clock:" :value "${cpu_freq_g} GHz")
    (row :label "CPU Temp :" :value "${cpu_temp}°C")
    (bar-row :label "CPU Usage:" :value "${cpu_use}%" :pct cpu_use)
    (row :label "Process:" :value "${procs_total}  Running: ${procs_run}")))

;; RAM
(defwidget w-ram []
  (box :class "section" :orientation "v" :space-evenly false
    (divider)
    (bar-row :label " RAM Use:" :value "${ram_used}/${ram_total}" :pct ram_pct)
    (bar-row :label "Swap Use:" :value "${swap_used}/${swap_total} - ${swap_pct}%" :pct swap_pct)))

;; GPU
(defwidget w-gpu []
  (box :class "section" :orientation "v" :space-evenly false
    (divider)
    (box :orientation "h" :space-evenly false
      (label :class "icon" :text "󰢮 ")
      (label :class "lbl" :text "GPU: ")
      (label :class "val" :text "NVIDIA ${gpu_name}" :truncate true))
    (row :label "GPU Clock:" :value gpu_clock)
    (row :label "GPU Use:" :value "${gpu_use}%")
    (row :label "GPU RAM Use:" :value "${gpu_mem_u} / ${gpu_mem_t}")
    (row :label "GPU Temp:" :value "${gpu_temp}°C")))

;; DISK
(defwidget w-disk []
  (box :class "section" :orientation "v" :space-evenly false
    (divider)
    (box :orientation "h" :space-evenly false
      (label :class "icon" :text " ")
      (label :class "lbl" :text "File System"))
    (bar-row :label "/" :value "${disk_used}/${disk_total}" :pct disk_pct)
    (row :label " Disk Use:" :value disk_io)))

;; RED
(defwidget w-net []
  (box :class "section" :orientation "v" :space-evenly false
    (divider)
    (box :orientation "h" :space-evenly false
      (label :class "icon" :text "󰤨 ")
      (label :class "lbl" :text "Network: ")
      (label :class "val" :text {net_ssid != "" ? "Wi-Fi: ${net_ssid}" : "LAN: ${net_iface}"}))
    (row :label " Upstream:" :value net_up)
    (row :label " Downstream:" :value net_down)))

;; TOP PROCESOS
(defwidget w-top []
  (box :class "section top-section" :orientation "v" :space-evenly false
    (divider)
    (box :class "top-header" :orientation "h" :space-evenly false
      (label :class "col-name" :text "Name" :xalign 0 :hexpand true)
      (label :class "col-h" :text " PID" :xalign 1)
      (label :class "col-h" :text "  CPU%" :xalign 1)
      (label :class "col-h" :text "  MEM%" :xalign 1))
    (for line in {split(top_procs, "\n")}
      (box :class "top-row" :orientation "h" :space-evenly false
        (label :class "col-name" :text {substring(line, 0, 14)} :xalign 0 :hexpand true :truncate true)
        (label :class "col-v" :text {substring(line, 14, 21)} :xalign 1)
        (label :class "col-v" :text {substring(line, 21, 27)} :xalign 1)
        (label :class "col-v" :text {substring(line, 27, 33)} :xalign 1)))))

;; SIDEBAR COMPLETO
(defwidget sidebar []
  (box :class "sidebar" :orientation "v" :space-evenly false :vexpand true
    (w-info)
    (w-cpu)
    (w-ram)
    (w-gpu)
    (w-disk)
    (w-net)
    (w-top)))

;; ─── VENTANA ────────────────────────────────

(defwindow sidebar-window
  :monitor 0
  :geometry (geometry
              :x "60px"
              :y "60px"
              :width "280px"
              :anchor "top right")
  :stacking "bg"
  :focusable false
  :namespace "sidebar"
  (sidebar))
