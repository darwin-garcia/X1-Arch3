// ██║    ██║██╔══██╗╚██╗ ██╔╝██╔══██╗██╔══██╗██╔══██╗
// ██║ █╗ ██║███████║ ╚████╔╝ ██████╔╝███████║██████╔╝
// ██║███╗██║██╔══██║  ╚██╔╝  ██╔══██╗██╔══██║██╔══██╗
// ╚███╔███╔╝██║  ██║   ██║   ██████╔╝██║  ██║██║  ██║
//  ╚══╝╚══╝ ╚═╝  ╚═╝   ╚═╝   ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝
// 
// ▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀▄▀
{
  "include": [
		"~/.config/waybar/Modules",
		"~/.config/waybar/Workspaces"
  ],
  "layer": "top",
  "width": "96%",
  "margin-top": 10,


  // ░█▄█░█▀█░█▀▄░█░█░█░░░█▀▀░█▀▀
  // ░█░█░█░█░█░█░█░█░█░░░█▀▀░▀▀█
  // ░▀░▀░▀▀▀░▀▀░░▀▀▀░▀▀▀░▀▀▀░▀▀▀

  "modules-left": ["custom/launcher", "hyprland/workspaces"],
  "modules-right":["network","bluetooth","pulseaudio#input","pulseaudio#output","backlight","battery","clock","custom/power"],

  // Modules Definition
  "custom/launcher" : {
		"tooltip": true,
		"tooltip-format" : "󰣇 Start Here :-)",
    	"format" : "󰣇 ",
    	"on-click": "rofi -show drun",
    	"on-click-right": "killall rofi"
  },

  "custom/power":{
		"exec": "echo $USER",
		"interval": "once",
		"tooltip": true,
		"tooltip-format" : "⏻ Power Options",
    	"format": "<span color='#f7768e'>⏻</span>",		
		"menu": "on-click",
    	"menu-file": "~/.config/waybar/power_menu.xml",
		"menu-actions": {
			"reload": "hyprctl reload",
			"shutdown": "poweroff",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate",
			"logout": "hyprctl dispatch exit"
		}
  }, 
	"custom/notifications": {
	    "exec": "COUNT=$(makoctl list 2>/dev/null | jq '.data | length' 2>/dev/null || echo 0); if [ \"$COUNT\" -gt 0 ]; then echo \"{\\\"text\\\":\\\" $COUNT\\\",\\\"tooltip\\\":\\\"$COUNT notificación(es)\\\",\\\"class\\\":\\\"has-notif\\\"}\"; else echo \"{\\\"text\\\":\\\" \\\",\\\"tooltip\\\":\\\"Sin notificaciones\\\",\\\"class\\\":\\\"empty\\\"}\"; fi",
		"return-type": "json",
		"interval": 5,
		"on-click": "makoctl dismiss -a",
		"on-click-right": "makoctl restore"	
	},
	"custom/control": {
		"format": "⚙",
		"tooltip": true,
		"tooltip-format" : "⚙ Settings",
		"on-click": "eww open-many controlcenter"
	},
    "custom/updates": {
		"exec": "COUNT=$(~/.config/hypr/scripts/checkupdates.sh 2>/dev/null | wc -l); if [ \"$COUNT\" -gt 0 ]; then echo \"{\\\"text\\\":\\\" $COUNT\\\",\\\"tooltip\\\":\\\"$COUNT actualización(es) disponible(s)\\\",\\\"class\\\":\\\"has-updates\\\"}\"; else echo \"{\\\"text\\\":\\\" \\\",\\\"tooltip\\\":\\\"Sistema actualizado\\\",\\\"class\\\":\\\"up-to-date\\\"}\"; fi",
		"return-type": "json",
		"interval": 600,
		"on-click": "kitty -e sudo pacman -Syu"
    }

}
